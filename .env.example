# Copy this file to `.env` and fill in the blank secrets before starting the API.
#   PowerShell:  Copy-Item .env.example .env
# Never commit `.env`; it is listed in .gitignore.

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Most hosts (Render, Railway, Heroku) inject PORT at runtime; keep 5000 locally.
PORT=5000

# --- Database --------------------------------------------------------------
# Local Docker Mongo started by docker-compose.yml (single-node replica set).
# A replica set is required for the multi-document transactions used by orders.
MONGODB_URI=mongodb://localhost:27017/ecommerce?replicaSet=rs0
# Local MongoDB service without a replica set (no transactions):
# MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce
# Managed MongoDB Atlas in production (replica set included):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority

# --- Authentication --------------------------------------------------------
# Intentionally blank: a placeholder that satisfies the 32-character minimum
# would let a public secret reach production. Generate a unique value per
# environment and keep it out of source control:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# bcrypt cost factor. Use 12 in production; tests override this with 10 for speed.
BCRYPT_ROUNDS=12

# --- Networking ------------------------------------------------------------
# Comma-separated list of browser origins allowed by CORS. Leave blank to block
# all cross-origin requests. List only the real front-end origins in production.
CORS_ORIGINS=http://localhost:3000

# --- Bootstrap admin -------------------------------------------------------
# Used only by `npm run seed:admin`; public registration always creates a
# customer. Leave the password blank until you seed, then set a strong unique
# value (12+ characters) and rotate it.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
