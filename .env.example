# Copy this file to `.env` and fill in the blank secrets before starting the API.
#   PowerShell:  Copy-Item .env.example .env
# Never commit `.env`; it is listed in .gitignore.

# --- Server ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Most hosts (Render, Railway, Heroku) inject PORT at runtime; 5000 locally.
PORT=5000
# debug | info | warn | error - consumed by the structured logger (added Day 4).
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Pick the line that matches where the API runs:
#   API on your machine + Mongo in Docker -> keep directConnection=true (below)
#   API inside docker compose             -> mongodb://mongo:27017/ecommerce?replicaSet=rs0
#   Local standalone Mongo (no Docker)    -> mongodb://127.0.0.1:27017/ecommerce
#   MongoDB Atlas (production)            -> mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority
# directConnection skips replica-set member discovery, so the host name the set
# was initiated with never has to resolve from your machine. Transactions still
# work because the member itself is a replica set.
MONGODB_URI=mongodb://localhost:27017/ecommerce?directConnection=true

# --- Authentication -------------------------------------------------------
# Generate a unique value per environment; never reuse an example value.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# bcrypt cost factor: 12 in production; the test suite overrides it with 10.
BCRYPT_ROUNDS=12

# --- CORS -----------------------------------------------------------------
# Comma-separated browser origins. Leave blank to block all cross-origin
# requests; list only your real front-end origins in production.
CORS_ORIGINS=http://localhost:3000

# --- Seed admin (used only by: npm run seed:admin) ------------------------
# Public registration always creates a customer. Leave the password blank until
# you seed, then set a strong unique value and rotate it.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
