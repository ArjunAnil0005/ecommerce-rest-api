{
  "info": {
    "_postman_id": "11c9fc5b-438c-48f7-8eaf-cbd4b02ccf74",
    "name": "E-commerce REST API - Day 1 to Day 5",
    "description": "Main customer journey plus admin category, product, and order management. Import the companion environment, fill adminEmail/adminPassword, and run requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "customerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "rootCategoryId", "value": "" },
    { "key": "childCategoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "adminOrderId", "value": "" },
    { "key": "runSuffix", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": ["pm.collectionVariables.set('runSuffix', String(Date.now()));"]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API responds successfully', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"postman-{{runSuffix}}@example.com\",\n  \"password\": \"{{customerPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer account created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('customerToken', pm.response.json().data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin signed in', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('adminToken', pm.response.json().data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create root category",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{adminToken}}", "type": "string" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Electronics {{runSuffix}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Root category created', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('rootCategoryId', pm.response.json().data.category._id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Create child category",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{adminToken}}", "type": "string" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mobiles {{runSuffix}}\",\n  \"parent\": \"{{rootCategoryId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Child category created', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('childCategoryId', pm.response.json().data.category._id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{adminToken}}", "type": "string" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Smartphone {{runSuffix}}\",\n  \"sku\": \"POSTMAN-{{runSuffix}}\",\n  \"description\": \"Product created by the Postman workflow\",\n  \"pricePaise\": 4500000,\n  \"salePricePaise\": 4200000,\n  \"stock\": 5,\n  \"category\": \"{{childCategoryId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product created', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('productId', pm.response.json().data.product._id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter products by parent category",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/products?category={{rootCategoryId}}&minPrice=4000000&maxPrice=5000000&sort=price&page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "products"],
          "query": [
            { "key": "category", "value": "{{rootCategoryId}}" },
            { "key": "minPrice", "value": "4000000" },
            { "key": "maxPrice", "value": "5000000" },
            { "key": "sort", "value": "price" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Descendant product appears in category results', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.some(function (product) { return product._id === pm.collectionVariables.get('productId'); })).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Place customer order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{customerToken}}", "type": "string" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/v1/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order placed using server prices', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('orderId', pm.response.json().data.order._id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Cancel own pending order",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{customerToken}}", "type": "string" }
          ]
        },
        "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/cancel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order cancelled and stock restored', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.order.status).to.eql('cancelled');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Place order for admin status workflow",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{customerToken}}", "type": "string" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/v1/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Second order placed', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('adminOrderId', pm.response.json().data.order._id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin confirms order",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{adminToken}}", "type": "string" }
          ]
        },
        "body": { "mode": "raw", "raw": "{\"status\":\"confirmed\"}" },
        "url": "{{baseUrl}}/api/v1/orders/{{adminOrderId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin confirms order', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin processes order",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{adminToken}}", "type": "string" }
          ]
        },
        "body": { "mode": "raw", "raw": "{\"status\":\"processing\"}" },
        "url": "{{baseUrl}}/api/v1/orders/{{adminOrderId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin advances order to processing', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin cancels processing order and restores stock",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{adminToken}}", "type": "string" }
          ]
        },
        "body": { "mode": "raw", "raw": "{\"status\":\"cancelled\"}" },
        "url": "{{baseUrl}}/api/v1/orders/{{adminOrderId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin cancellation restores stock', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.order.status).to.eql('cancelled');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
